#include <stdio.h>
#include <string.h>

#define MAX 100

int main() {

    int n;
    scanf("%d", &n);

    char names[MAX][50];
    int freq[MAX] = {0};
    int used[MAX] = {0};

    // Input names
    for (int i = 0; i < n; i++) {
        scanf("%s", names[i]);
    }

    // Count frequency
    for (int i = 0; i < n; i++) {

        if (used[i] == 1)
            continue;

        freq[i] = 1;
        used[i] = 1;

        for (int j = i + 1; j < n; j++) {
            if (strcmp(names[i], names[j]) == 0) {
                freq[i]++;
                used[j] = 1;
            }
        }
    }

    // Find winner
    int maxVotes = 0;
    char winner[50];

    for (int i = 0; i < n; i++) {

        if (freq[i] > maxVotes) {
            maxVotes = freq[i];
            strcpy(winner, names[i]);
        }
        else if (freq[i] == maxVotes) {
            if (strcmp(names[i], winner) < 0) {
                strcpy(winner, names[i]);
            }
        }
    }

    printf("%s %d", winner, maxVotes);

    return 0;
}
