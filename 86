#include <stdio.h>

int main() {

    int n;
    scanf("%d", &n);

    int low = 0, high = n;
    int ans = 0;

    while (low <= high) {

        long long mid = (low + high) / 2;
        long long sq = mid * mid;

        if (sq == n) {
            printf("%d", (int)mid);
            return 0;
        }
        else if (sq < n) {
            ans = mid;   // store best answer so far
            low = mid + 1;
        }
        else {
            high = mid - 1;
        }
    }

    printf("%d", ans);

    return 0;
}
