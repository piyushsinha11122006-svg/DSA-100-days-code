#include <stdio.h>
#include <stdlib.h>

#define MAX 100

// Tree node
struct Node {
    int data;
    struct Node *left, *right;
};

// Queue node (for BFS + HD tracking)
struct QNode {
    struct Node* node;
    int hd;
};

// Simple queue
struct QNode queue[MAX];
int front = 0, rear = 0;

// Insert into queue
void enqueue(struct Node* node, int hd) {
    queue[rear].node = node;
    queue[rear].hd = hd;
    rear++;
}

// Remove from queue
struct QNode dequeue() {
    return queue[front++];
}

// Create node
struct Node* createNode(int value) {
    struct Node* newNode =
        (struct Node*)malloc(sizeof(struct Node));

    newNode->data = value;
    newNode->left = newNode->right = NULL;
    return newNode;
}

// Build tree from level order
struct Node* buildTree(int arr[], int n) {
    if (n == 0 || arr[0] == -1)
        return NULL;

    struct Node* q[MAX];
    int f = 0, r = 0;

    struct Node* root = createNode(arr[0]);
    q[r++] = root;

    int i = 1;

    while (i < n) {
        struct Node* curr = q[f++];

        // left
        if (i < n && arr[i] != -1) {
            curr->left = createNode(arr[i]);
            q[r++] = curr->left;
        }
        i++;

        // right
        if (i < n && arr[i] != -1) {
            curr->right = createNode(arr[i]);
            q[r++] = curr->right;
        }
        i++;
    }

    return root;
}

// Vertical Order Traversal
void verticalOrder(struct Node* root) {
    if (root == NULL)
        return;

    struct QNode q[MAX];
    int f = 0, r = 0;

    int hdMap[2 * MAX] = {0};
    int minHD = 0, maxHD = 0;

    // Start BFS
    q[r].node = root;
    q[r].hd = 0;
    r++;

    while (f < r) {
        struct QNode temp = q[f++];

        struct Node* curr = temp.node;
        int hd = temp.hd;

        printf("%d\n", curr->data);

        // Left
        if (curr->left != NULL) {
            q[r].node = curr->left;
            q[r].hd = hd - 1;
            r++;

            if (hd - 1 < minHD)
                minHD = hd - 1;
        }

        // Right
        if (curr->right != NULL) {
            q[r].node = curr->right;
            q[r].hd = hd + 1;
            r++;

            if (hd + 1 > maxHD)
                maxHD = hd + 1;
        }
    }
}

int main() {
    int n;
    scanf("%d", &n);

    int arr[n];

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    struct Node* root = buildTree(arr, n);

    verticalOrder(root);

    return 0;
}
