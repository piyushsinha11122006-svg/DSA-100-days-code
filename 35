#include <stdio.h>

#define MAX 100

int queue[MAX];
int front = 0;
int rear = -1;

// Enqueue operation
void enqueue(int value) {
    if (rear == MAX - 1) {
        return; // overflow (not needed for this problem)
    }
    queue[++rear] = value;
}

// Display queue
void display() {
    for (int i = front; i <= rear; i++) {
        printf("%d", queue[i]);
        if (i != rear)
            printf(" ");
    }
}

int main() {
    int n;

    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        int x;
        scanf("%d", &x);
        enqueue(x);
    }

    display();

    return 0;
}
