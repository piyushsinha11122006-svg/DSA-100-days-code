#include <stdio.h>
#include <stdbool.h>

// Function to check if it's possible to paint all boards within 'maxTime' 
// using at most 'k' painters.
bool isPossible(int boards[], int n, int k, long long maxTime) {
    int paintersUsed = 1;
    long long currentBoardSum = 0;

    for (int i = 0; i < n; i++) {
        // If a single board is longer than maxTime, it's impossible
        if (boards[i] > maxTime) return false;

        if (currentBoardSum + boards[i] <= maxTime) {
            currentBoardSum += boards[i];
        } else {
            // Allocate to a new painter
            paintersUsed++;
            currentBoardSum = boards[i];
            
            if (paintersUsed > k) return false;
        }
    }
    return true;
}

int main() {
    int n, k;
    if (scanf("%d %d", &n, &k) != 2) return 0;

    int boards[n];
    long long low = 0;
    long long high = 0;

    for (int i = 0; i < n; i++) {
        scanf("%d", &boards[i]);
        if (boards[i] > low) low = boards[i]; // Lower bound is the largest board
        high += boards[i];                   // Upper bound is the sum of all boards
    }

    long long result = high;

    // Binary Search for the minimum "maximum time"
    while (low <= high) {
        long long mid = low + (high - low) / 2;

        if (isPossible(boards, n, k, mid)) {
            result = mid;   // Try to find a smaller maximum time
            high = mid - 1;
        } else {
            low = mid + 1;  // Need more time to accommodate all boards
        }
    }

    printf("%lld\n", result);

    return 0;
}
