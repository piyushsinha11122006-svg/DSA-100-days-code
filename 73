#include <stdio.h>
#include <string.h>

#define MAX 1000

int main() {

    char s[MAX];
    scanf("%s", s);

    int freq[26] = {0};

    int len = strlen(s);

    // Step 1: count frequency
    for (int i = 0; i < len; i++) {
        freq[s[i] - 'a']++;
    }

    // Step 2: find first non-repeating
    for (int i = 0; i < len; i++) {
        if (freq[s[i] - 'a'] == 1) {
            printf("%c", s[i]);
            return 0;
        }
    }

    // If none found
    printf("$");

    return 0;
}
