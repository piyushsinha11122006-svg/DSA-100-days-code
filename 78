#include <stdio.h>

#define MAX 100
#define INF 999999

int main() {

    int n, m;
    scanf("%d %d", &n, &m);

    int graph[MAX][MAX];

    // initialize graph
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            graph[i][j] = INF;

    // input edges (undirected)
    for (int i = 0; i < m; i++) {
        int u, v, w;
        scanf("%d %d %d", &u, &v, &w);

        u--; v--;

        graph[u][v] = w;
        graph[v][u] = w;
    }

    int visited[MAX] = {0};
    int dist[MAX];

    for (int i = 0; i < n; i++)
        dist[i] = INF;

    // start from node 0
    dist[0] = 0;

    int totalCost = 0;

    for (int count = 0; count < n; count++) {

        int u = -1, min = INF;

        // pick minimum distance node
        for (int i = 0; i < n; i++) {
            if (!visited[i] && dist[i] < min) {
                min = dist[i];
                u = i;
            }
        }

        visited[u] = 1;
        totalCost += dist[u];

        // update neighbors
        for (int v = 0; v < n; v++) {
            if (graph[u][v] < dist[v] && !visited[v]) {
                dist[v] = graph[u][v];
            }
        }
    }

    printf("%d", totalCost);

    return 0;
}
