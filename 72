#include <stdio.h>
#include <string.h>

#define MAX 1000
#define INF 999999

int main() {

    char s[MAX];
    scanf("%s", s);

    int first[26];

    // initialize
    for (int i = 0; i < 26; i++)
        first[i] = -1;

    int minSecondIndex = INF;
    char result = -1;

    for (int i = 0; i < strlen(s); i++) {

        int idx = s[i] - 'a';

        if (first[idx] == -1) {
            // first occurrence
            first[idx] = i;
        }
        else {
            // repeated character
            if (i < minSecondIndex) {
                minSecondIndex = i;
                result = s[i];
            }
        }
    }

    if (result == -1)
        printf("-1");
    else
        printf("%c", result);

    return 0;
}
