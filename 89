#include <stdio.h>
#include <string.h>
#include <stdbool.h>

void longestPalindrome(char* s) {
    int n = strlen(s);
    if (n == 0) return;

    bool dp[n][n];
    memset(dp, 0, sizeof(dp));

    int maxLength = 1;
    int start = 0;

    // All substrings of length 1 are palindromes
    for (int i = 0; i < n; i++) {
        dp[i][i] = true;
    }

    // Check for substrings of length 2
    for (int i = 0; i < n - 1; i++) {
        if (s[i] == s[i + 1]) {
            dp[i][i + 1] = true;
            start = i;
            maxLength = 2;
        }
    }

    // Check for lengths greater than 2
    // k is the current length of the substring
    for (int k = 3; k <= n; k++) {
        for (int i = 0; i < n - k + 1; i++) {
            // Get the ending index of substring from starting index i
            int j = i + k - 1;

            // Check if the inner substring is a palindrome and outer chars match
            if (dp[i + 1][j - 1] && s[i] == s[j]) {
                dp[i][j] = true;
                if (k > maxLength) {
                    start = i;
                    maxLength = k;
                }
            }
        }
    }

    printf("Longest Palindromic Substring is: ");
    for (int i = start; i < start + maxLength; i++) {
        printf("%c", s[i]);
    }
    printf("\nLength: %d", maxLength);
}

int main() {
    char str[] = "babad";
    longestPalindrome(str);
    return 0;
}
