#include <stdio.h>
#include <stdlib.h>

#define MAX 100

// Tree node
struct Node {
    int data;
    struct Node *left, *right;
};

// Queue for building tree
struct Node* queue[MAX];
int front = 0, rear = 0;

void enqueue(struct Node* node) {
    queue[rear++] = node;
}

struct Node* dequeue() {
    return queue[front++];
}

// Create node
struct Node* createNode(int value) {
    struct Node* newNode =
        (struct Node*)malloc(sizeof(struct Node));

    newNode->data = value;
    newNode->left = newNode->right = NULL;
    return newNode;
}

// Build tree (level order)
struct Node* buildTree(int arr[], int n) {
    if (n == 0 || arr[0] == -1)
        return NULL;

    struct Node* q[MAX];
    int f = 0, r = 0;

    struct Node* root = createNode(arr[0]);
    q[r++] = root;

    int i = 1;

    while (i < n) {
        struct Node* curr = q[f++];

        // left
        if (i < n && arr[i] != -1) {
            curr->left = createNode(arr[i]);
            q[r++] = curr->left;
        }
        i++;

        // right
        if (i < n && arr[i] != -1) {
            curr->right = createNode(arr[i]);
            q[r++] = curr->right;
        }
        i++;
    }

    return root;
}

// Mirror tree
void mirror(struct Node* root) {
    if (root == NULL)
        return;

    // Swap children
    struct Node* temp = root->left;
    root->left = root->right;
    root->right = temp;

    // Recur
    mirror(root->left);
    mirror(root->right);
}

// Inorder traversal
void inorder(struct Node* root) {
    if (root == NULL)
        return;

    inorder(root->left);
    printf("%d ", root->data);
    inorder(root->right);
}

int main() {
    int n;
    scanf("%d", &n);

    int arr[n];

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    struct Node* root = buildTree(arr, n);

    mirror(root);

    inorder(root);

    return 0;
}
